# ============================================
# EMAS Boutique - Environment Variables
# ============================================
# Copia este archivo como .env.local y llena los valores

# --- Database ---
# Neon PostgreSQL (serverless). URL de tu base de datos.
DATABASE_URL=postgresql://usuario:password@ep-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# --- Admin Panel ---
# Credenciales para iniciar sesión en /admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=tu-contraseña-segura

# Secreto para firmar sesiones del admin.
# Generalo con: openssl rand -base64 32
ADMIN_SESSION_SECRET=generate-with-openssl-rand-base64-32

# --- Cloudinary ---
# Para subir imágenes de productos
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=tu-cloud-name
CLOUDINARY_API_KEY=tu-api-key
CLOUDINARY_API_SECRET=tu-api-secret

# --- Site ---
# URL base del sitio (sin slash al final)
NEXT_PUBLIC_SITE_URL=https://emasboutique.com
